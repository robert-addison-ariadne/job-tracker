{
  "_readme": "Settings for the job tracker. The morning search (scripts/fetch_jobs.py) collects jobs, scores them with these settings, and the dashboard shows the ones that pass. Keyword rules: words match whole words only; a * at the end matches any ending (\"journalis*\" matches journalist and journalism).",

  "search": {
    "_locations_note": "South of England, covered as circles around these towns (radius in miles).",
    "locations": [
      { "name": "London", "distance_miles": 35 },
      { "name": "Brighton", "distance_miles": 30 },
      { "name": "Canterbury", "distance_miles": 30 },
      { "name": "Southampton", "distance_miles": 35 },
      { "name": "Oxford", "distance_miles": 30 },
      { "name": "Bristol", "distance_miles": 40 },
      { "name": "Exeter", "distance_miles": 45 }
    ],
    "max_days_old": 14,
    "queries": [
      "policy officer",
      "policy assistant",
      "policy and research",
      "social research",
      "research officer",
      "research assistant",
      "parliamentary assistant",
      "caseworker",
      "public affairs",
      "campaigns officer",
      "campaigns assistant",
      "advocacy officer",
      "human rights",
      "social justice",
      "think tank",
      "journalist",
      "trainee journalist",
      "junior reporter",
      "news assistant",
      "editorial assistant",
      "publishing assistant",
      "press officer",
      "communications officer",
      "communications assistant",
      "music PR",
      "music marketing",
      "sustainability officer",
      "community engagement",
      "regeneration officer",
      "international development",
      "humanitarian",
      "refugee",
      "civil service",
      "graduate scheme",
      "record label",
      "music industry",
      "music assistant"
    ],
    "_graduate_note": "Also collects the newest jobs Reed has tagged as graduate jobs around each town.",
    "graduate_pass": true,
    "exclude_title_words": ["senior", "lead", "principal", "head of", "director", "chief", "partner", "vp", "vice president"]
  },

  "abroad": {
    "_note": "Jobs outside the UK only show if they score at least min_fit (a strong match), in a different coloured box.",
    "min_fit": 5,
    "remotive_categories": ["writing", "all-others", "project-management"],
    "_reliefweb_note": "ReliefWeb (humanitarian & development jobs worldwide) only runs once a RELIEFWEB_APPNAME secret is added in GitHub.",
    "reliefweb_query": "communications OR policy OR research OR advocacy OR campaigns OR editor OR journalist OR \"social impact\" OR sustainability OR migration",
    "reliefweb_categories": ["Information and Public Affairs", "Advocacy/Communications", "Monitoring and Evaluation", "Program/Project Management"]
  },

